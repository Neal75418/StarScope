# StarScope Sidecar Environment Configuration
# Copy this file to .env and fill in your values

# ==================== GitHub OAuth (Optional) ====================
# 「連結 GitHub」（Device Flow）用內建的 OAuth App，不需要設定。
# 只有要改用自己的 OAuth App 時才取消註解（該 App 要在設定裡啟用 Device Flow）：
# https://github.com/settings/developers
# GITHUB_CLIENT_ID=Ov23lixxxxxxxxxxxx

# ==================== GitHub Token (Legacy) ====================
# Alternative: Use a Personal Access Token instead of OAuth
# This is used as fallback if OAuth is not configured
# Create at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Environment mode
# development = enables debug logging
# production = minimal logging
ENV=development

# Debug mode (enables hot reload)
# Set to "true" only in development
DEBUG=false

# Server port (default: 8008)
PORT=8008

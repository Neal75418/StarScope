root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,json,css,html}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.rs]
indent_style = space
indent_size = 4

[*.{toml,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown 用行尾兩個空白表示強制換行，被 trim 掉會靜默弄壞排版
[*.md]
trim_trailing_whitespace = false
